# Netlify injects NETLIFY_DATABASE_URL automatically on deploy.
# For local work, `netlify dev` provides one; or point at any Postgres:
# DATABASE_URL=postgres://...

# Rotating key used to HMAC editor IPs. Raw IPs are never stored.
IP_HASH_SECRET=change-me-and-rotate-monthly

# Optional: logo.dev token. Without it, logos fall back to the favicon service.
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Optional: Cloudflare Turnstile (bot check on the edit form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
