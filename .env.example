# Local dev uses a SQLite file. For prod, point at Turso.
DATABASE_URL=file:./local.db
# DATABASE_AUTH_TOKEN=

# Rotating key used to HMAC editor IPs. Raw IPs are never stored.
IP_HASH_SECRET=change-me-and-rotate-monthly

# Optional: Cloudflare Turnstile (bot check on the edit form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
